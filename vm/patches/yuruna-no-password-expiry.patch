diff --git a/host/vmconfig/ubuntu.server.base.user-data b/host/vmconfig/ubuntu.server.base.user-data
index 8c5d995..336586e 100644
--- a/host/vmconfig/ubuntu.server.base.user-data
+++ b/host/vmconfig/ubuntu.server.base.user-data
@@ -127,7 +127,26 @@ APT_PROXY_BLOCK_PLACEHOLDER
       ExecStart=/lib/systemd/systemd-networkd-wait-online --any --timeout=15
       EOF
     # --- REGION: https://yuruna.link/vmconfig#force-first-login-password-change
-    - curtin in-target --target=/target -- passwd --expire USERNAME_PLACEHOLDER
+    # KENNEL BYPASS (issue #8) -- disabled for the SSH-driven baseline.
+    #
+    # `passwd --expire` is LOAD-BEARING for the *gui* sequence: it produces the
+    # first-login Current/New/Retype dialog that start.guest.ubuntu.server.24.yml
+    # drives with its passwdPrompt steps.
+    #
+    # It is FATAL for the *ssh* sequence. start.guest.amazon.linux.2023.ssh.yml
+    # states the assumption the ubuntu ssh variant inherited -- "key auth
+    # bypasses the cloud-init forced first-login password change" -- and on
+    # Ubuntu 24.04 that assumption is false. With UsePAM yes, pam_unix returns
+    # PAM_NEW_AUTHTOK_REQD during account management, so sshd refuses EVERY
+    # non-interactive session even though publickey auth already succeeded:
+    #     You are required to change your password immediately (administrator enforced).
+    #     Password change required but no TTY available.
+    # sshWaitReady can therefore never go ready, and burns its full timeout.
+    #
+    # Restore the line below to run the gui sequence for this guest.
+    # Retirement path: upstream should gate this on the sequence's
+    # keystrokeMechanism instead of applying it unconditionally.
+    # - curtin in-target --target=/target -- passwd --expire USERNAME_PLACEHOLDER
     # --- REGION: https://yuruna.link/vmconfig#login-session-budget
     - bash -c 'sed -i -E "/^[#[:space:]]*LOGIN_TIMEOUT/d" /target/etc/login.defs && echo "LOGIN_TIMEOUT 180" >> /target/etc/login.defs'
     # --- REGION: https://yuruna.link/vmconfig#passwordless-sudo-for-harness-user
